{
  "$schema": "../../../../../api/plugin-manifest.schema.json",
  "name": "ru.raydroid.plugin.impl.calculator",
  "title": "app.name",
  "description": "app.description",
  "author": "app.author",
  "version": -1,
  "platforms": [],
  "categories": [],
  "license": "",
  "commands": [
    {
      "service": "CalculatorCommand",
      "title": "command.calculator.title",
      "description": "command.calculator.description",
      "mode": "Inline",
      "match": "[0-9].*",
      "arguments": [],
      "preferences": []
    }
  ],
  "resources": {
    "strings": {
      "app.name": "Calculator",
      "app.main": "Calculator",
      "app.description": "Calculator extension",
      "app.author": "Raydroid",
      "app.label": "Your results lol:",
      "command.calculator.title": "Calculator",
      "command.calculator.description": "Calculator extension"
    },
    "strings-ru": {
      "app.description": "Калькулятор"
    }
  },
  "access": {
    "clipboard": {
      "permissions": ["read", "write"]
    },
    "cache": {
      "permissions": ["manage"],
      "requested_size": "1mb"
    },
    "environment": {
      "permissions": ["read"],
      "access": ["*"]
    },
    "network": {
      "permissions": ["manage"],
      "allowed_urls": ["https://example.com/*", "https://.*"]
    },
    "preferences": {
      "permissions": ["manage"],
      "requested_size": "1mb"
    },
    "storage": {
      "permissions": ["manage"],
      "requested_size": "1mb"
    },
    "system": {
      "permissions": ["get_apps", "open_resource", "open_app"],
      "visible_apps": [".*"],
      "allowed_urls": [".*"]
    },
    "runtime": {
      "requested_stack_size": 1024
    }
  }
}

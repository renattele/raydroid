{
  "$schema": "../../../../../api/plugin-manifest.schema.json",
  "name": "ru.raydroid.plugin.impl.calculator",
  "title": "app.name",
  "description": "app.description",
  "author": "app.author",
  "version": -1,
  "platforms": [],
  "categories": [],
  "license": "",
  "commands": [
    {
      "service": "CalculatorCommand",
      "title": "command.calculator.title",
      "description": "command.calculator.description",
      "placeholder": "command.calculator.placeholder",
      "icon": {
        "value": "Calculate",
        "type": "Builtin"
      },
      "mode": "Inline",
      "match": ".*([0-9].*[-+*/^%!()]|[-+*/^%!()].*[0-9]|\\b(pi|e)\\b|[0-9A-Za-z]+(ns(\\([0-9]+\\)|[0-9]+)|bin|oct|hex)|ns(\\([0-9]+\\)|[0-9]+)\\(.*\\)|(bin|oct|hex)\\(.*\\)).*",
      "arguments": [],
      "preferences": []
    }
  ],
  "resources": {
    "strings": {
      "app.name": "Calculator",
      "app.main": "Calculator",
      "app.description": "Calculator extension",
      "app.author": "Raydroid",
      "command.calculator.title": "Calculator",
      "command.calculator.description": "Type an expression",
      "command.calculator.placeholder": "Calculate...",
      "calculator.result.empty": "No result"
    },
    "strings-ru": {
      "app.description": "Калькулятор",
      "calculator.result.empty": "Нет результата"
    }
  },
  "access": {
    "notification": {
      "show_alerts": false,
      "show_toasts": false
    },
    "search_field": {
      "permissions": ["write"]
    },
    "runtime": {
      "requested_stack_size": 1024
    }
  }
}

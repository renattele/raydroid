{
  "$schema": "../../../../../api/plugin-manifest.schema.json",
  "name": "ru.raydroid.plugin.impl.weather",
  "title": "app.name",
  "description": "app.description",
  "author": "Raydroid",
  "version": -1,
  "platforms": [],
  "categories": ["Weather"],
  "license": "",
  "commands": [
    {
      "service": "WeatherCommand",
      "title": "command.weather.title",
      "description": "command.weather.description",
      "placeholder": "command.weather.placeholder",
      "icon": {
        "value": "WbSunny",
        "type": "Builtin"
      },
      "mode": "Inline",
      "match": ".*",
      "arguments": [],
      "preferences": []
    }
  ],
  "resources": {
    "strings": {
      "app.name": "Weather",
      "app.description": "Weather by selected city",
      "command.weather.title": "Weather",
      "command.weather.description": "Choose a city and show its weather",
      "command.weather.placeholder": "Search city..."
    }
  },
  "access": {
    "network": {
      "permissions": ["manage"],
      "allowed_urls": [
        "https://api\\.open-meteo\\.com/.*",
        "https://geocoding-api\\.open-meteo\\.com/.*"
      ]
    },
    "storage": {
      "permissions": ["manage"],
      "requested_size": "256kb"
    },
    "notification": {
      "show_alerts": false,
      "show_toasts": true
    },
    "runtime": {
      "requested_stack_size": 1024
    }
  }
}

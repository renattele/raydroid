{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raydroid.local/schemas/plugin-manifest.schema.json",
  "title": "Raydroid Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "title",
    "description",
    "author",
    "version",
    "platforms",
    "categories",
    "license",
    "commands",
    "resources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "title": {
      "$ref": "#/definitions/resourceKey"
    },
    "description": {
      "$ref": "#/definitions/resourceKey"
    },
    "author": {
      "$ref": "#/definitions/resourceKey"
    },
    "version": {
      "type": "integer"
    },
    "platforms": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/platform"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/command"
      }
    },
    "resources": {
      "$ref": "#/definitions/resourceBuckets"
    }
  },
  "definitions": {
    "platform": {
      "type": "string",
      "enum": [
        "Android",
        "IOS"
      ]
    },
    "resourceKey": {
      "type": "string",
      "minLength": 1,
      "description": "String resource key from a strings bucket (for example resources.strings or resources.strings-ru)"
    },
    "resourceBuckets": {
      "type": "object",
      "description": "Android-like resource buckets, for example strings, strings-ru, images, images-night",
      "patternProperties": {
        "^(strings|images)(-[A-Za-z0-9_]+)*$": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "title",
        "description",
        "mode",
        "match",
        "arguments",
        "preferences"
      ],
      "properties": {
        "service": {
          "type": "string"
        },
        "title": {
          "$ref": "#/definitions/resourceKey"
        },
        "description": {
          "$ref": "#/definitions/resourceKey"
        },
        "mode": {
          "type": "string",
          "enum": [
            "View",
            "NoView",
            "Inline"
          ]
        },
        "match": {
          "type": [
            "string",
            "null"
          ]
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/commandArgument"
          }
        },
        "preferences": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/commandPreference"
          }
        }
      }
    },
    "commandArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "placeholder",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "placeholder": {
          "$ref": "#/definitions/resourceKey"
        },
        "type": {
          "type": "string",
          "enum": [
            "Text",
            "Password",
            "Dropdown"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "commandPreference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "description",
        "type",
        "placeholder",
        "default"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "$ref": "#/definitions/resourceKey"
        },
        "description": {
          "$ref": "#/definitions/resourceKey"
        },
        "type": {
          "type": "string",
          "enum": [
            "Text",
            "Password",
            "Checkbox",
            "Dropdown",
            "AppPicker",
            "File",
            "Directory"
          ]
        },
        "placeholder": {
          "anyOf": [
            {
              "$ref": "#/definitions/resourceKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "default": {
          "type": "string"
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raydroid.local/schemas/plugin-manifest.schema.json",
  "title": "Raydroid Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "title",
    "description",
    "author",
    "version",
    "platforms",
    "categories",
    "license",
    "commands",
    "resources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "title": {
      "$ref": "#/definitions/resourceKey"
    },
    "description": {
      "$ref": "#/definitions/resourceKey"
    },
    "author": {
      "$ref": "#/definitions/resourceKey"
    },
    "version": {
      "type": "integer"
    },
    "platforms": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/platform"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/command"
      }
    },
    "resources": {
      "$ref": "#/definitions/resourceBuckets"
    },
    "access": {
      "$ref": "#/definitions/access"
    }
  },
  "definitions": {
    "platform": {
      "type": "string",
      "enum": [
        "Android",
        "IOS",
        "Linux",
        "Windows",
        "MacOS"
      ]
    },
    "resourceKey": {
      "type": "string",
      "minLength": 1,
      "description": "String resource key from a strings bucket (for example resources.strings or resources.strings-ru)"
    },
    "resourceBuckets": {
      "type": "object",
      "description": "Android-like resource buckets, for example strings, strings-ru, images, images-night",
      "patternProperties": {
        "^(strings|images)(-[A-Za-z0-9_]+)*$": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "title",
        "description",
        "mode",
        "match",
        "arguments",
        "preferences"
      ],
      "properties": {
        "service": {
          "type": "string"
        },
        "title": {
          "$ref": "#/definitions/resourceKey"
        },
        "description": {
          "$ref": "#/definitions/resourceKey"
        },
        "placeholder": {
          "$ref": "#/definitions/resourceKey"
        },
        "mode": {
          "type": "string",
          "enum": [
            "View",
            "NoView",
            "Inline"
          ]
        },
        "match": {
          "type": [
            "string",
            "null"
          ]
        },
        "searchable": {
          "type": "boolean",
          "default": true
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/commandArgument"
          }
        },
        "preferences": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/commandPreference"
          }
        }
      }
    },
    "commandArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "placeholder",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "placeholder": {
          "$ref": "#/definitions/resourceKey"
        },
        "type": {
          "type": "string",
          "enum": [
            "Text",
            "Password",
            "Dropdown"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "commandPreference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "description",
        "type",
        "placeholder",
        "default"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "$ref": "#/definitions/resourceKey"
        },
        "description": {
          "$ref": "#/definitions/resourceKey"
        },
        "type": {
          "type": "string",
          "enum": [
            "Text",
            "Password",
            "Checkbox",
            "Dropdown",
            "AppPicker",
            "File",
            "Directory"
          ]
        },
        "placeholder": {
          "anyOf": [
            {
              "$ref": "#/definitions/resourceKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "default": {
          "type": "string"
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clipboard": {
          "$ref": "#/definitions/clipboardAccess"
        },
        "cache": {
          "$ref": "#/definitions/sizedAccess"
        },
        "environment": {
          "$ref": "#/definitions/environmentAccess"
        },
        "network": {
          "$ref": "#/definitions/networkAccess"
        },
        "notification": {
          "$ref": "#/definitions/notificationAccess"
        },
        "preferences": {
          "$ref": "#/definitions/sizedAccess"
        },
        "search_field": {
          "$ref": "#/definitions/searchFieldAccess"
        },
        "storage": {
          "$ref": "#/definitions/sizedAccess"
        },
        "system": {
          "$ref": "#/definitions/systemAccess"
        },
        "runtime": {
          "$ref": "#/definitions/runtimeAccess"
        }
      }
    },
    "clipboardAccess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          }
        }
      }
    },
    "sizedAccess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "manage"
            ]
          }
        },
        "requested_size": {
          "type": "string"
        }
      }
    },
    "environmentAccess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read"
            ]
          }
        },
        "access": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "networkAccess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "manage"
            ]
          }
        },
        "allowed_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "notificationAccess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show_alerts": {
          "type": "boolean"
        },
        "show_toasts": {
          "type": "boolean"
        }
      }
    },
    "searchFieldAccess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "write",
              "manage"
            ]
          }
        }
      }
    },
    "systemAccess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "get_apps",
              "open_resource",
              "open_app"
            ]
          }
        },
        "visible_apps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "runtimeAccess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested_stack_size": {
          "type": "integer"
        }
      }
    }
  }
}
